{

  "ConnectionStrings":{
    "DefaultConnection":"",
    "Redis":"localhost:6379"
  },
  "Jwt":{
    "Issuer":"EMS",
    "Audience":"EMSUsers",
    "ExpireMinutes":60
  },
  "Logging": {
    "LogLevel": {
      "Default":"Information",
      "Microsoft.AspNetCore":"Warning",
      "MicrosoftEntityFrameworkCore":"Warning",
      "Backend":"Information"
    },
    "Console": {
      "IncludeScopes":true
    }
  },


  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {          
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore":"Warning"
      }
    },
    "WriteTo":[
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path":"Logs/log-.txt",
          "rollingInterval":"Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
